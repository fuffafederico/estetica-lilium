---
import { Picture } from 'astro:assets';
import photo from '../../assets/images/trattamento-viso.jpg';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import { services, site, treatments } from '../../data/site';

const quickLinks = [...services, ...treatments].map((item) => ({ label: item.title, href: `#${item.slug}` }));
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__panel">
      <div class="hero__copy">
        <p class="chip">Centro estetico · Fabriano</p>
        <h1 id="hero-title">La bellezza di <span class="hero__accent">sentirsi bene.</span></h1>
        <p class="lead">
          Un luogo dedicato alla cura di sé, dove trattamenti estetici e momenti di relax si incontrano per regalarti
          un’esperienza di benessere.
        </p>
        <div class="hero__actions">
          <Button href="#trattamenti" arrow>Scopri i trattamenti</Button>
          <Button href="#contatti" variant="white">Contatta il centro</Button>
        </div>
        <ul class="hero__meta" role="list">
          <li>
            <a href={site.mapsUrl} target="_blank" rel="noopener">
              <Icon name="pin" size={20} />
              <span>{site.address.full}</span>
              <span class="visually-hidden">(si apre in una nuova scheda)</span>
            </a>
          </li>
          <li>
            <a href={site.phone.href}>
              <Icon name="phone" size={20} />
              <span>{site.phone.display}</span>
            </a>
          </li>
        </ul>
      </div>

      <figure class="hero__media">
        <Picture
          src={photo}
          alt="Trattamento viso: le mani della estetista accompagnano il viso rilassato di una cliente"
          formats={['avif', 'webp']}
          widths={[420, 640, 860, 1306]}
          sizes="(min-width: 60rem) 40vw, 90vw"
          width={1306}
          height={1632}
          fit="cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </div>

    <nav class="quick" aria-label="Vai direttamente a">
      <p class="quick__label">Cosa cerchi?</p>
      <ul class="quick__list" role="list">
        {quickLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-s) var(--space-l);
  }

  .hero__panel {
    display: grid;
    gap: var(--space-l);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(ellipse 60% 70% at 85% 55%, rgb(255 255 255 / 0.65), transparent 70%),
      var(--blush);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-m);
    align-content: center;
    justify-items: start;
  }
  .hero__copy .chip {
    background: var(--white);
  }
  .hero__copy .lead {
    max-width: 32rem;
    color: var(--cacao);
  }
  .hero__accent {
    color: var(--mauve-deep);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
  }

  .hero__media {
    position: relative;
    justify-self: center;
    width: min(100%, 28rem);
  }
  .hero__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    object-position: 30% 40%;
    border-radius: 50% 50% var(--r-lg) var(--r-lg) / 34% 34% var(--r-lg) var(--r-lg);
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-xs);
  }
  .hero__meta a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.4rem 1.1rem;
    border-radius: var(--r-pill);
    background: rgb(255 255 255 / 0.6);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .hero__meta a:hover {
    background: var(--white);
  }
  .hero__meta a :global(svg) {
    flex: none;
    color: var(--mauve-deep);
  }

  .quick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
    margin-top: var(--space-m);
  }
  .quick__label {
    font-weight: 700;
  }
  .quick__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .quick__list a {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--blush);
    border-radius: var(--r-pill);
    background: var(--white);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }
  .quick__list a:hover {
    background: var(--blush-100);
    border-color: var(--nude);
  }

  /* Smartphone: i collegamenti rapidi scorrono in una sola riga */
  @media (max-width: 47.99rem) {
    .quick {
      display: grid;
      gap: var(--space-2xs);
    }
    .quick__list {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0.25rem var(--gutter) 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
    }
    .quick__list li {
      flex: none;
      scroll-snap-align: start;
    }
  }

  @media (min-width: 60rem) {
    .hero {
      padding-top: var(--space-m);
    }
    .hero__panel {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: var(--space-xl);
      padding-block: var(--space-xl);
    }
    .hero__media {
      width: min(100%, 30rem);
      justify-self: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__meta a,
    .quick__list a {
      transition: none;
    }
  }
</style>
