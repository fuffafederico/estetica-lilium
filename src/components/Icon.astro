---
/** Set di icone linea, coerente per stile e tratto. Tutte decorative (aria-hidden). */
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const icons = {
  // Interfaccia (viewBox 24)
  phone: { vb: 24, body: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>' },
  pin: { vb: 24, body: '<path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>' },
  mail: { vb: 24, body: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3.5 7.5 8.5 6 8.5-6"/>' },
  instagram: { vb: 24, body: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>' },
  facebook: { vb: 24, body: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>' },
  arrow: { vb: 24, body: '<path d="M5 12h14M13 6l6 6-6 6"/>' },
  sparkle: { vb: 24, body: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/>' },
  // Illustrazioni di servizi e trattamenti (viewBox 32)
  nail: { vb: 32, body: '<rect x="9" y="14" width="14" height="14" rx="4"/><path d="M13 14v-3h6v3M14.5 11V4.5a1.5 1.5 0 0 1 3 0V11M13 19v5"/>' },
  drop: { vb: 32, body: '<path d="M14 6c4 5 7 8.500 7 12.500a7 7 0 0 1-14 0C7 14.500 10 11 14 6z"/><path d="M25 5v6M22 8h6"/>' },
  lash: { vb: 32, body: '<path d="M3 18c3-5 7-7 13-7s10 2 13 7c-3 5-7 7-13 7S6 23 3 18z"/><circle cx="16" cy="18" r="3.500"/><path d="M8 10 6.500 6.500M16 8V4M24 10l1.500-3.500"/>' },
  jar: { vb: 32, body: '<rect x="6" y="14" width="20" height="13" rx="4"/><rect x="7.500" y="8" width="17" height="6" rx="2.500"/><path d="M11 19v4"/>' },
  stones: { vb: 32, body: '<ellipse cx="16" cy="24" rx="10" ry="3.800"/><ellipse cx="16" cy="17" rx="7" ry="3.200"/><ellipse cx="16" cy="11" rx="4.200" ry="2.600"/>' },
  steam: { vb: 32, body: '<path d="M10 25c-2.500-3 2.500-5 0-8.500s2.500-5 0-8.500M16 25c-2.500-3 2.500-5 0-8.500s2.500-5 0-8.500M22 25c-2.500-3 2.500-5 0-8.500s2.500-5 0-8.500M5 29h22"/>' },
  lily: { vb: 32, body: '<path d="M16 3c3.500 4.500 4.500 10 0 16-4.500-6-3.500-11.500 0-16z"/><path d="M15 19.500C9 19.500 5 16 3.500 10.500 9.500 9.500 14 12.500 15 19.500zM17 19.500c6 0 10-3.500 11.500-9C22.500 9.500 18 12.500 17 19.500z"/><path d="M16 19v10M16 26c-3.500 0-6-1-7.500-3"/>' },
  gift: { vb: 32, body: '<rect x="5" y="13" width="22" height="15" rx="2.500"/><rect x="4" y="9" width="24" height="4.500" rx="1.500"/><path d="M16 9v19M16 9c-3-5-9-4-6.500.5M16 9c3-5 9-4 6.500.5"/>' },
} as const;

const { name, size = 24, class: className } = Astro.props;
const icon = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox={`0 0 ${icon.vb} ${icon.vb}`}
  fill="none"
  stroke="currentColor"
  stroke-width={icon.vb === 32 ? 1.5 : 1.7}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icon.body}
/>
