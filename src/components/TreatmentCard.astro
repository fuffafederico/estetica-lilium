---
import Icon from './Icon.astro';

interface Props {
  slug: string;
  title: string;
  text: string;
  tags: readonly string[];
  icon: 'jar' | 'stones' | 'steam' | 'lily';
}
const { slug, title, text, tags, icon } = Astro.props;
---

<article class="treatment reveal" id={slug}>
  <header class="treatment__head">
    <span class="treatment__icon"><Icon name={icon} size={32} /></span>
    <h3>{title}</h3>
  </header>
  <p>{text}</p>
  <ul class="treatment__tags" role="list" aria-label={`Caratteristiche: ${title}`}>
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>

<style>
  .treatment {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border-radius: var(--r-lg);
    background: var(--white);
  }

  .treatment__head {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }
  .treatment__head h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem);
  }
  .treatment__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    background: var(--blush-100);
    color: var(--mauve-deep);
  }

  .treatment p {
    color: var(--cacao-soft);
  }

  /* I tag restano sempre allineati in basso, qualunque sia la lunghezza del testo */
  .treatment__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: var(--space-2xs);
  }
  .treatment__tags li {
    padding: 0.35rem 0.95rem;
    border-radius: var(--r-pill);
    background: var(--blush-100);
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.3;
  }
</style>
