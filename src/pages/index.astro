---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Services from '../components/sections/Services.astro';
import Treatments from '../components/sections/Treatments.astro';
import Experience from '../components/sections/Experience.astro';
import Promotions from '../components/sections/Promotions.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout title="Estetica Lilium · Centro estetico a Fabriano">
  <Header />
  <main id="contenuto">
    <Hero />
    <Intro />
    <Services />
    <Treatments />
    <Experience />
    <Promotions />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
